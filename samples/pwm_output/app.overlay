#include <zephyr/dt-bindings/pwm/pwm.h>

/* Hardware PWM must use P1. The built-in XIAO LED is on P2.00.
 * This standalone example drives D0/A0 (P1.04) instead, at nominal 1 kHz.
 */
/ {
	zephyr,user {
		pwms = <&pwm20 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
	};
};

&pinctrl {
	pwm20_default: pwm20_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
		};
	};
	pwm20_sleep: pwm20_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
			low-power-enable;
		};
	};
};

&pwm20 {
	status = "okay";
	pinctrl-0 = <&pwm20_default>;
	pinctrl-1 = <&pwm20_sleep>;
	pinctrl-names = "default", "sleep";
};
